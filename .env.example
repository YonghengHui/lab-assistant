# 复制成 .env 再填自己的 key（.env 已在 .gitignore 里）
LAB_HOST=127.0.0.1            # 服务绑定地址（手机访问就填局域网/Tailscale IP）
LAB_PORT=8901
DASHSCOPE_API_KEY=            # 阿里百炼：ASR / TTS / 备用视觉模型
DEEPSEEK_API_KEY=             # 主模型（也可换别的 OpenAI 兼容服务）
TAVILY_API_KEY=               # 可选：联网搜索
LAB_MODEL=deepseek-chat                # 对话主模型
LAB_OCR_MODEL=deepseek-chat            # 读照片用的视觉模型
LAB_OCR_FALLBACK=qwen-vl-plus
# 视频抽帧数、推流帧尺寸等在 lab.html / lab_server.py 顶部常量里
