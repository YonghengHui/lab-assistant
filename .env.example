# 复制成 .env 再填自己的 key（.env 已在 .gitignore 里）
# lab_server.py / app.py 启动时会自动读同目录下的 .env；已经 export 过的环境变量优先（systemd 的
# EnvironmentFile= 依然有效）。任何一行留空 = 用代码里的默认值。
LAB_HOST=127.0.0.1            # 服务绑定地址（手机访问就填局域网 IP 或 Tailscale IP —— 见下面「部署到公网」）
LAB_PORT=8901

# ── 访问口令（可选，默认关闭）──────────────────────────────────────
# 留空 = 不鉴权：适合只在局域网 / Tailscale 里用（默认行为，最省事）。
# 要在公网暴露这个服务，就填一个长随机串（例如 openssl rand -hex 24 的输出）：
#   之后打开页面会先要求输入口令，登录一次即可（写 cookie，30 天有效）；
#   也支持 ?token=xxx 或 Authorization: Bearer xxx（给 curl / 脚本用）。
LAB_TOKEN=

# ── 服务商：只需改下面这几行中的一组 ──────────────────────────────
# 默认组合（最省事）：对话用 DeepSeek，视觉/听写/播报用阿里百炼
DASHSCOPE_API_KEY=            # 阿里百炼：ASR / TTS / 视觉 https://bailian.console.aliyun.com/
DEEPSEEK_API_KEY=             # 对话主模型 https://platform.deepseek.com/
TAVILY_API_KEY=               # 可选：联网搜索 https://tavily.com/

LAB_MODEL=deepseek-chat                # 对话主模型
LAB_OCR_MODEL=qwen-vl-max              # 读照片用的视觉模型（必须是支持图片的模型）
LAB_OCR_FALLBACK=qwen-vl-plus          # 主视觉模型读空/报错时的兜底
LAB_ASR_MODEL=qwen3-asr-flash          # 语音转文字

LAB_LOG_CONTENT=0             # 日志里是否记录提问/转写原文，0=不记（默认，保护隐私），1=记

# ── 想换别的服务商？把上面的地址/模型换成对应值即可（都走 OpenAI 兼容协议）──
# 阿里百炼（一个 key 全包）
#   LAB_MODEL=qwen-plus        LAB_OCR_MODEL=qwen-vl-max   LAB_ASR_MODEL=qwen3-asr-flash
# OpenAI
#   LAB_MODEL=gpt-4o-mini      LAB_OCR_MODEL=gpt-4o        （国内直连通常需要代理）
# 智谱 GLM
#   LAB_MODEL=glm-4-flash      LAB_OCR_MODEL=glm-4v-flash
# 月之暗面 Kimi
#   LAB_MODEL=moonshot-v1-8k   LAB_OCR_MODEL=moonshot-v1-8k-vision-preview
# 硅基流动 SiliconFlow
#   LAB_MODEL=Qwen/Qwen3-8B    LAB_OCR_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# 本地 Ollama（不用 key，填一个占位值；手机访问要用电脑局域网 IP + OLLAMA_ORIGINS=*）
#   LAB_MODEL=qwen2.5vl:7b     LAB_OCR_MODEL=qwen2.5vl:7b  （语音识别需另接云端）
#
# 换别家的「接口地址」时改下面这几个（都在 lab_server.py 顶部，也可以用环境变量覆盖）：
#   LAB_DEEPSEEK_BASE=https://api.deepseek.com/v1        # 对话（模型名以 deepseek 开头时走它）
#   LAB_VISION_BASE=https://xxx/v1                       # 看图（OpenAI 兼容）
#   LAB_ASR_BASE=https://xxx/v1                          # 语音转文字（OpenAI 兼容）
#   LAB_VISION_KEY= / LAB_ASR_KEY=                       # 视觉/听写想用另一个 key 时填
# 单文件版（standalone.html）不需要 .env —— 在页面 ⚙️ 里选服务商预设即可。

# 视频抽帧数、推流帧尺寸等在 lab.html / lab_server.py 顶部常量里
